variable "subscription_id" {
  description = "Approved MCAPS sandbox subscription."
  type        = string
}

variable "tenant_id" {
  description = "MCAPS sandbox tenant."
  type        = string
}

variable "location" {
  description = "Region supporting the selected VM and database HA configurations."
  type        = string
  default     = "swedencentral"
}

variable "unique_suffix" {
  description = "Optional naming suffix; null generates a persistent suffix in this environment's separate state."
  type        = string
  default     = null
}

variable "virtual_machine" {
  description = "VM image, sizing and disks; administrator credentials are generated by the lab module."
  type = object({
    os_type        = optional(string, "Windows")
    size           = optional(string, "Standard_B2s_v2")
    admin_username = optional(string, "azureadmin")
    source_image_reference = optional(object({
      publisher = string
      offer     = string
      sku       = string
      version   = string
    }))
    os_disk = optional(object({
      storage_account_type = optional(string, "StandardSSD_LRS")
      disk_size_gb         = optional(number)
      caching              = optional(string, "ReadWrite")
    }), {})
    data_disks = optional(map(object({
      lun                  = number
      disk_size_gb         = number
      storage_account_type = optional(string, "StandardSSD_LRS")
      caching              = optional(string, "ReadWrite")
    })), {})
  })
  default = {}
}

variable "postgresql" {
  description = "PostgreSQL Flexible Server and HA configuration."
  type = object({
    administrator_login = optional(string, "pgadminuser")
    sku_name            = optional(string, "GP_Standard_D2ds_v5")
    version_number      = optional(string, "16")
    storage_mb          = optional(number, 32768)
    zone                = optional(string, "1")
    high_availability = optional(object({
      enabled                   = optional(bool, true)
      mode                      = optional(string, "ZoneRedundant")
      standby_availability_zone = optional(string, "2")
    }), {})
  })
  default = {}
}

variable "mysql" {
  description = "MySQL Flexible Server and HA configuration; Burstable compute cannot enable HA."
  type = object({
    administrator_login = optional(string, "mysqladminuser")
    sku_name            = optional(string, "GP_Standard_D2ds_v4")
    version_number      = optional(string, "8.0.21")
    zone                = optional(string, "1")
    high_availability = optional(object({
      enabled                   = optional(bool, true)
      mode                      = optional(string, "ZoneRedundant")
      standby_availability_zone = optional(string, "2")
    }), {})
  })
  default = {}
}

variable "tags" {
  description = "Owner and purpose tags for this isolated, billable test environment."
  type        = map(string)
  default     = {}
}
