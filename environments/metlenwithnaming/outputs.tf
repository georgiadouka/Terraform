output "resource_group_name" {
  description = "Lab resource group name."
  value       = module.resource_group.name
}

output "resource_group_id" {
  description = "Lab resource group ID."
  value       = module.resource_group.id
}

output "virtual_network_id" {
  description = "Lab virtual network ID."
  value       = module.network.id
}

output "subnet_ids" {
  description = "Lab subnet IDs."
  value       = module.network.subnet_ids
}

output "hub_peering" {
  description = "Hub peering IDs and names, or null when hub_peering is not set. hub_to_spoke is null when the hub side is managed outside this configuration."
  value = var.hub_peering == null ? null : {
    hub_virtual_network_id = var.hub_peering.hub_virtual_network_id
    spoke_to_hub = {
      id   = module.spoke_to_hub_peering[0].id
      name = module.spoke_to_hub_peering[0].name
    }
    hub_to_spoke = local.hub_to_spoke_peering_enabled ? {
      id   = module.hub_to_spoke_peering[0].id
      name = module.hub_to_spoke_peering[0].name
    } : null
  }
}

output "generated_resource_names" {
  description = "Resource names generated by the centralized naming convention."
  value       = merge(local.resource_names, { private_endpoints = local.private_endpoint_names })
}

output "virtual_machines" {
  description = "Virtual machine details keyed by the configured logical VM name."
  value = {
    for key, vm in module.virtual_machine : key => {
      id                 = vm.id
      name               = vm.name
      private_ip_address = vm.private_ip_address
      os_type            = var.virtual_machines[key].os_type
      admin_username     = var.virtual_machines[key].admin_username
      data_disk_ids      = vm.data_disk_ids
    }
  }
}

output "virtual_machine_scale_sets" {
  description = "Virtual Machine Scale Set details keyed by the configured logical scale set name."
  value = {
    for key, scale_set in module.virtual_machine_scale_set : key => {
      id                   = scale_set.id
      name                 = scale_set.name
      os_type              = scale_set.os_type
      admin_username       = var.virtual_machine_scale_sets[key].admin_username
      principal_id         = scale_set.principal_id
      autoscale_setting_id = scale_set.autoscale_setting_id
      scaling_mode         = scale_set.scaling_mode
      computer_name_prefix = local.resource_names.virtual_machine_scale_sets[key].computer_name_prefix
    }
  }
}

output "nat_gateway_id" {
  description = "Shared NAT Gateway ID, or null when nat_gateway.subnets is empty."
  value       = try(module.nat_gateway[0].id, null)
}

output "load_balancers" {
  description = "Internal load balancers keyed by logical name, with their frontend IP, backend pool, and the VMs and scale sets that joined it."
  value = {
    for key, load_balancer in module.load_balancer : key => {
      id                          = load_balancer.id
      name                        = load_balancer.name
      frontend_private_ip_address = load_balancer.frontend_private_ip_address
      backend_address_pool_id     = load_balancer.backend_address_pool_id
      subnet_id                   = module.network.subnet_ids["load_balancers"]
      probe_ids                   = load_balancer.probe_ids
      rule_ids                    = load_balancer.rule_ids
      virtual_machines            = sort([for vm_key, vm in var.virtual_machines : vm_key if vm.load_balancer == key])
      virtual_machine_scale_sets  = sort([for vmss_key, scale_set in var.virtual_machine_scale_sets : vmss_key if scale_set.load_balancer == key])
    }
  }
}

output "nat_gateway_public_ip_address" {
  description = "Static outbound IPv4 address of the subnets in nat_gateway.subnets, or null when no NAT Gateway is created."
  value       = try(module.nat_gateway[0].public_ip_address, null)
}

output "network_security_groups" {
  description = "Network security groups keyed by logical name, with their rule IDs and associated subnet keys."
  value = {
    for key, nsg in module.network_security_group : key => {
      id                = nsg.id
      name              = nsg.name
      security_rule_ids = nsg.security_rule_ids
      subnets           = var.network_security_groups[key].subnets
    }
  }
}

output "route_tables" {
  description = "Route tables keyed by logical name, with their route IDs and associated subnet keys."
  value = {
    for key, route_table in module.route_table : key => {
      id        = route_table.id
      name      = route_table.name
      route_ids = route_table.route_ids
      subnets   = var.route_tables[key].subnets
    }
  }
}

output "key_vaults" {
  description = "Key Vault details keyed by the configured logical vault name."
  value = {
    for key, vault in module.key_vault : key => {
      id        = vault.id
      name      = vault.name
      vault_uri = vault.vault_uri
      hostname  = "${vault.name}.vault.azure.net"
    }
  }
}

output "container_registries" {
  description = "Azure Container Registry details keyed by the configured logical registry name."
  value = {
    for key, registry in module.container_registry : key => {
      id           = registry.id
      name         = registry.name
      login_server = registry.login_server
      sku          = registry.sku
    }
  }
}

output "azure_sql_servers" {
  description = "Azure SQL server details keyed by the configured logical server name. elastic_pool_id and elastic_pool_name are null for a standalone database."
  value = {
    for key, server in module.azure_sql : key => {
      id                          = server.server_id
      name                        = server.server_name
      fully_qualified_domain_name = server.fully_qualified_domain_name
      database_id                 = server.database_id
      database_name               = server.database_name
      elastic_pool_id             = server.elastic_pool_id
      elastic_pool_name           = server.elastic_pool_name
    }
  }
}

output "sql_managed_instances" {
  description = "SQL Managed Instance details keyed by the configured logical name (at most one)."
  value = {
    for key, instance in module.sql_managed_instance : key => {
      id                          = instance.id
      name                        = local.resource_names.sql_managed_instances[key].name
      fqdn                        = instance.fqdn
      principal_id                = instance.principal_id
      network_security_group_id   = instance.network_security_group_id
      network_security_group_name = local.resource_names.sql_managed_instances[key].network_security_group_name
      route_table_id              = instance.route_table_id
      route_table_name            = local.resource_names.sql_managed_instances[key].route_table_name
    }
  }
}

output "postgresql_servers" {
  description = "PostgreSQL Flexible Server details keyed by the configured logical server name."
  value = {
    for key, server in module.postgresql : key => {
      id                        = server.id
      name                      = server.name
      fqdn                      = server.fqdn
      database_id               = server.database_id
      database_name             = server.database_name
      administrator_login       = var.postgresql_servers[key].administrator_login
      high_availability_enabled = var.postgresql_servers[key].high_availability.enabled
    }
  }
}



output "mysql_servers" {
  description = "MySQL Flexible Server details keyed by the configured logical server name."
  value = {
    for key, server in module.mysql : key => {
      id                        = server.id
      name                      = server.name
      fqdn                      = server.fqdn
      database_id               = server.database_id
      database_name             = server.database_name
      administrator_login       = var.mysql_servers[key].administrator_login
      high_availability_enabled = var.mysql_servers[key].high_availability.enabled
    }
  }
}

output "cosmos_db_accounts" {
  description = "Cosmos DB account details keyed by the configured logical account name."
  value = {
    for key, account in module.cosmos_db : key => {
      id           = account.id
      name         = account.name
      api_type     = account.api_type
      endpoint     = account.endpoint
      hostname     = account.hostname
      database_id  = account.database_id
      container_id = account.container_id
      principal_id = account.principal_id
    }
  }
}

output "container_apps_environments" {
  description = "Container Apps environments keyed by logical name, with their dedicated workload profile names and Container Apps."
  value = {
    for key, environment in module.container_apps : key => {
      id                               = environment.environment_id
      name                             = environment.environment_name
      default_domain                   = environment.default_domain
      static_ip_address                = environment.static_ip_address
      subnet_id                        = module.network.subnet_ids["container_apps/${key}"]
      dedicated_workload_profile_names = environment.dedicated_workload_profile_names
      apps                             = environment.apps
    }
  }
}

output "databricks_workspaces" {
  description = "Azure Databricks workspace details keyed by the configured logical workspace name. workspace_url is the host for the databricks provider; access_connector_id is the Unity Catalog storage credential identity."
  value = {
    for key, workspace in module.databricks : key => {
      id                               = workspace.id
      name                             = workspace.name
      workspace_url                    = workspace.workspace_url
      workspace_id                     = workspace.workspace_id
      network_access                   = workspace.network_access
      managed_resource_group_name      = workspace.managed_resource_group_name
      root_storage_account_name        = workspace.root_storage_account_name
      network_security_group_name      = workspace.network_security_group_name
      host_subnet_id                   = module.network.subnet_ids["databricks/${key}/host"]
      container_subnet_id              = module.network.subnet_ids["databricks/${key}/container"]
      access_connector_id              = workspace.access_connector_id
      access_connector_principal_id    = workspace.access_connector_principal_id
      browser_authentication_workspace = var.databricks_workspaces[key].browser_authentication_workspace
      delete_lock_id                   = try(azurerm_management_lock.databricks_browser_authentication[key].id, null)
    }
  }
}

output "log_analytics_workspace_id" {
  description = "Shared Log Analytics workspace ID when any Container Apps environment, Application Insights resource or Databricks diagnostic setting exists."
  value       = try(module.log_analytics[0].id, null)
}

output "application_insights" {
  description = "Shared Application Insights resource (id, name, app_id and the keys of the apps sending telemetry), or null when no app uses it. The connection string is passed to the apps directly and is not output."
  value = local.application_insights_required ? {
    id     = module.application_insights[0].id
    name   = module.application_insights[0].name
    app_id = module.application_insights[0].app_id
    apps   = sort(keys(local.application_insights_apps))
  } : null
}

output "app_service_plans" {
  description = "App Service Plan details keyed by the configured logical plan name, with the keys of the apps running on each plan."
  value = {
    for key, plan in module.app_service_plan : key => {
      id            = plan.id
      name          = plan.name
      os_type       = var.app_service_plans[key].os_type
      sku_name      = var.app_service_plans[key].sku_name
      web_apps      = sort([for app_key, app in var.web_apps : app_key if app.service_plan == key])
      function_apps = sort([for app_key, app in var.function_apps : app_key if app.service_plan == key])
    }
  }
}

output "function_apps" {
  description = "Private Function App details keyed by the configured logical app name."
  value = {
    for key, app in module.function_app : key => {
      id                    = app.id
      name                  = local.resource_names.function_apps[key].name
      hostname              = app.default_hostname
      os_type               = app.os_type
      principal_id          = app.principal_id
      service_plan          = var.function_apps[key].service_plan
      service_plan_id       = app.service_plan_id
      service_plan_name     = local.resource_names.app_service_plans[var.function_apps[key].service_plan]
      storage_account_name  = module.function_storage[key].name
      storage_blob_hostname = "${module.function_storage[key].name}.blob.core.windows.net"
      application_insights  = contains(keys(local.application_insights_apps), "function_app/${key}")
    }
  }
}

output "web_apps" {
  description = "Private App Service Web App details keyed by the configured logical app name."
  value = {
    for key, app in module.web_app : key => {
      id                   = app.id
      name                 = local.resource_names.web_apps[key].name
      hostname             = app.default_hostname
      mode                 = app.mode
      principal_id         = app.principal_id
      service_plan         = var.web_apps[key].service_plan
      service_plan_id      = app.service_plan_id
      service_plan_name    = local.resource_names.app_service_plans[var.web_apps[key].service_plan]
      application_insights = contains(keys(local.application_insights_apps), "web_app/${key}")
    }
  }
}

output "storage_accounts" {
  description = "General-purpose v2 storage account details keyed by the configured logical account name."
  value = {
    for key, account in module.storage : key => {
      id                             = account.id
      name                           = account.name
      blob_hostname                  = "${account.name}.blob.core.windows.net"
      file_hostname                  = "${account.name}.file.core.windows.net"
      shared_access_key_enabled      = account.shared_access_key_enabled
      container_ids                  = account.container_ids
      file_share_ids                 = account.file_share_ids
      data_plane_role_assignment_ids = account.data_plane_role_assignment_ids
    }
  }
}

output "premium_file_accounts" {
  description = "Premium FileStorage account details keyed by the configured logical account name."
  value = {
    for key, account in module.premium_files : key => {
      id             = account.id
      name           = account.name
      file_hostname  = "${account.name}.file.core.windows.net"
      file_share_ids = account.file_share_ids
    }
  }
}

output "private_endpoint_ids" {
  description = "Private Endpoint IDs grouped by service."
  value = {
    container_registries = {
      for registry_key in keys(var.container_registries) :
      registry_key => module.private_endpoints["container_registry/${registry_key}"].id
    }
    key_vaults = {
      for vault_key in keys(var.key_vaults) :
      vault_key => module.private_endpoints["key_vault/${vault_key}"].id
    }
    storage = {
      for account_key, endpoints in module.storage_private_endpoints : account_key => endpoints.ids
    }
    premium_files = {
      for account_key in keys(var.premium_file_accounts) :
      account_key => module.private_endpoints["premium_files/${account_key}/file"].id
    }
    azure_sql_servers = {
      for server_key in keys(var.azure_sql_servers) :
      server_key => module.private_endpoints["azure_sql/${server_key}"].id
    }
    cosmos_db_accounts = {
      for account_key in keys(var.cosmos_db_accounts) :
      account_key => module.private_endpoints["cosmos_db/${account_key}"].id
    }
    web_apps = {
      for app_key in keys(var.web_apps) :
      app_key => module.private_endpoints["web_app/${app_key}"].id
    }
    function_apps = {
      for app_key, endpoint in module.function_app_private_endpoint : app_key => endpoint.id
    }
    function_storage = {
      for app_key, endpoints in module.function_storage_private_endpoints : app_key => endpoints.ids
    }
    databricks_workspaces = {
      for workspace_key, workspace in var.databricks_workspaces : workspace_key => {
        databricks_ui_api      = try(module.private_endpoints["databricks/${workspace_key}/databricks_ui_api"].id, null)
        browser_authentication = try(module.databricks_browser_authentication_private_endpoint["databricks/${workspace_key}/browser_authentication"].id, null)
      }
    }
  }
}
