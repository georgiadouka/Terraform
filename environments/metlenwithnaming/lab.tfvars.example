# One entry per Premium Azure Databricks workspace; an empty map creates none.
# Each workspace is injected into the lab VNet (subnet_cidrs.databricks entry
# with the same key, both subnets delegated to Azure Databricks and covered by
# the workspace's own NSG) and its clusters get no public IP addresses.
# network_access:
#   private         (default) public access off; users and clusters use the
#                   databricks_ui_api Private Endpoint.
#   backend_private users over the internet, clusters over the Private Endpoint.
#   public          users and clusters over the internet.
# Browser sign-in to private workspaces needs the region's single
# browser_authentication endpoint. Microsoft recommends a dedicated workspace
# for it: set browser_authentication_workspace = true on one private entry
# that runs no workloads; it gets only that endpoint and a CanNotDelete lock
# (delete_lock = false turns it off). Terraform warns when private workspaces
# have none, for example because a hub already provides it.
# Clusters need outbound internet access: add both subnets to
# nat_gateway.subnets (databricks/<key>/host, databricks/<key>/container) or
# route them to a hub firewall; Terraform warns otherwise.
# Names: workspace and Access Connector M-AZU-DBR-...-<sequence>, managed
# resource group M-AZU-RGP-...-<sequence>, NSG M-AZU-NSG-...-PRV-...-<sequence>,
# subnets <DPT><APP><ENV>PRV<host/container_subnet_number>. DBR was chosen on
# 2026-10-29 and is not in the register yet. Changing sequence, the subnet
# numbers or ranges replaces the workspace and everything in it.
databricks_workspaces = {}

# databricks_workspaces = {
#   analytics = {
#     sequence                = "00"
#     network_access          = "private"
#     host_subnet_number      = 12 # 10 and 11 by default; the jobs example above uses 10
#     container_subnet_number = 13
#     storage_sequence        = "08" # optional: name the root (DBFS) storage account
#
#     # Unity Catalog identity with Storage Blob Data Contributor on these
#     # storage_accounts keys.
#     access_connector = { storage_accounts = ["primary"] }
#
#     # Workspace resource logs to the shared Log Analytics workspace: every
#     # category by default (allLogs, the only category group Azure Databricks
#     # supports), or only the listed ones to limit ingestion cost.
#     diagnostics = { categories = ["accounts", "clusters", "jobs", "unityCatalog"] }
#   }
#
#   # Dedicated browser authentication workspace (WEB_AUTH in Microsoft's
#   # guidance). Small subnets are enough because it runs no clusters.
#   webauth = {
#     sequence                         = "01"
#     browser_authentication_workspace = true
#     host_subnet_number               = 14
#     container_subnet_number          = 15
#   }
# }

# App Service Plans, keyed by a stable logical name. This is the only place
# App Service Plan numbers are set: Web Apps and Function Apps select a plan
# by key, so two plans can never get the same name. Several apps can share one
# plan (they share its compute and scale together); give an app its own plan
# when it needs isolation. Basic/Standard/Premium plans host Web Apps,
# Elastic Premium (EP1-EP3) plans host Function Apps, and every app must match
# its plan's os_type. Names follow M-AZU-ASP-...-<sequence>; sequence must be
# unique per plan. Terraform warns about a plan no app uses, because it is
# still billed. Changing os_type or sequence replaces the plan and its apps.
app_service_plans = {
  web = {
    sequence = "00"
    os_type  = "Linux"
    sku_name = "B1"
  }

  functions = {
    sequence = "01"
    os_type  = "Linux"
    sku_name = "EP1"
  }

  # web-windows = {
  #   sequence = "02"
  #   os_type  = "Windows"
  #   sku_name = "B1"
  # }
}

# One entry per Web App, keyed by a stable logical name. Each entry creates its
# own Private Endpoint; every app joins the shared web_app_integration subnet
# (/26 or larger when apps on more than one plan share it).
web_apps = {
  primary = {
    # Key of a Basic, Standard or Premium app_service_plans entry.
    service_plan = "web"

    # Names follow M-AZU-APP-...-<sequence> (global <name>.azurewebsites.net);
    # sequence must be unique per app.
    sequence = "00"

    # Select one mode: linux, windows, or container. windows needs a Windows
    # plan; linux and container need a Linux plan.
    mode = "linux"

    # Linux supports node, python, and dotnet. Windows supports node and dotnet.
    runtime = {
      name    = "node"
      version = "22"
    }

    # Used only by container mode. This public sample requires no credentials.
    container = {
      registry_url = "https://mcr.microsoft.com"
      image_name   = "appsvc/staticsite:latest"
      port         = 80
    }

    app_settings = {}

    # Send telemetry to the shared Application Insights resource (default).
    # linux and windows modes also turn on the App Service agent; container
    # images need their own Application Insights SDK or OpenTelemetry distro.
    application_insights = true
  }

  # api = {
  #   service_plan = "web-windows"
  #   sequence     = "01"
  #   mode         = "windows"
  #   runtime = {
  #     name    = "dotnet"
  #     version = "8.0"
  #   }
  # }
}

# One entry per Function App, keyed by a stable logical name. Each entry creates
# its own host Storage Account with its content share and Private Endpoints
# (blob, file, queue, table and sites); every app joins the shared
# function_integration subnet (/26 or larger when apps on more than one plan
# share it).
function_apps = {
  primary = {
    # Key of an Elastic Premium app_service_plans entry; the plan's os_type
    # sets the app's OS.
    service_plan = "functions"

    # The Function App name has no NN in the standard, so at most one app may
    # leave sequence unset; set it for every further app or when the global
    # name is already taken.
    # sequence = "01"

    # NN of the Function host Storage Account (mazusoa...<NN>); unique across
    # storage_accounts, premium_file_accounts and every function_apps entry.
    storage_sequence = "02"

    # Set both runtime fields when changing language. Python requires a Linux
    # plan. Examples: node / 22, dotnet-isolated / 8.0, java / 21,
    # powershell / 7.4. For Windows, select a Windows Elastic Premium plan and
    # a compatible runtime, for example name = "dotnet-isolated",
    # version = "8.0". Moving to a plan with another OS recreates the app;
    # redeploy matching application code.
    runtime = {
      name    = "python"
      version = "3.11"
    }

    # Send telemetry to the shared Application Insights resource (default).
    application_insights = true
  }

  # jobs = {
  #   service_plan     = "functions"
  #   sequence         = "02"
  #   storage_sequence = "05"
  #   runtime = {
  #     name    = "python"
  #     version = "3.11"
  #   }
  # }
}

tags = {
  owner      = "platform-team"
  costCenter = "customer-project"
}
